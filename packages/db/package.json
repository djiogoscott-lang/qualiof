{
  "name": "@qualiof/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "import:smartof": "dotenv -e ../../.env -- tsx scripts/import-smartof.ts",
    "import:smartof-sessions": "dotenv -e ../../.env -- tsx scripts/import-smartof-sessions.ts",
    "import:agefice-pa": "dotenv -e ../../.env -- tsx scripts/import-agefice-pa.ts",
    "import:airtable": "dotenv -e ../../.env -- tsx scripts/import-airtable.ts",
    "import:treso": "dotenv -e ../../.env -- tsx scripts/import-treso-agefice.ts",
    "import:veille": "dotenv -e ../../.env -- tsx scripts/import-veille-from-xlsx.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@qualiof/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
